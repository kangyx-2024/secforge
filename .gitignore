# ============ 绝对不能进仓库的（密钥 / 体积）============
.env
.env.local
*.key
*.pem

# 数据库（127MB，超过 GitHub 单文件 100MB 硬上限）—— 用 scripts/fetch_data.sh 或自己构建
*.sqlite
*.sqlite-journal
*.db

# 抓取的原始数据（MSRC CVE 原始 JSON，单个 21MB）
vulndb/raw/
catalog/raw_repos.json

# ============ 构建产物 ============
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.build/
dist/
build/
*.app
native/.build/

# ============ 本地产物 / 日志 ============
*.log
loot/
work/
.DS_Store
.idea/
.vscode/
